# Секретный код, без которого регистрация нового пользователя отклоняется.
# Придумай длинную случайную строку и никому кроме приглашённых не давай.
INVITE_CODE=change-me-to-a-long-random-string

# false, пока сайт открыт по http:// (например по голому IP, без домена/HTTPS).
# Как только настроишь HTTPS (домен + Caddy/nginx с сертификатом) — переключи на true,
# иначе браузер не будет сохранять cookie сессии и логин перестанет работать.
COOKIE_SECURE=false
