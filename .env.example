# Домен, который указывает (A-запись) на IP этого VPS. Caddy сам получит для него
# HTTPS-сертификат Let's Encrypt.
DOMAIN=example.com

# Секретный код, без которого регистрация нового пользователя отклоняется.
# Придумай длинную случайную строку и никому кроме приглашённых не давай.
INVITE_CODE=change-me-to-a-long-random-string

# true — сайт теперь за Caddy по HTTPS, cookie сессии можно (и нужно) делать secure.
# Если вдруг тестируешь без Caddy/HTTPS напрямую по http:// — поставь false, иначе
# браузер не будет сохранять cookie и логин перестанет работать.
COOKIE_SECURE=true
